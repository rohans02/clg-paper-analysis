# Copy values into Streamlit Cloud App Settings -> Secrets (or a local .streamlit/secrets.toml, which is gitignored).
ADMIN_PASSWORD = "replace-with-strong-password"

# Optional: shared passcode faculty must enter to log in. Leave unset to keep faculty login open.
# FACULTY_PASSCODE = "replace-with-department-passcode"

# Optional: key used to sign login state kept in the URL. Defaults to ADMIN_PASSWORD.
# Set it to a long random string so rotating the admin password does not log everyone out.
# AUTH_SECRET = "replace-with-long-random-string"

